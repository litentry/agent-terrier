{
  "$comment": "Canonical design tokens; generate CSS and TypeScript with scripts/generate-tokens.mjs.",
  "fonts": {
    "display": "Bricolage Grotesque",
    "body": "Hanken Grotesk",
    "cn": "Noto Sans SC",
    "mono": "ui-monospace, Menlo, monospace"
  },
  "themes": {
    "meadow": {
      "label": "Meadow",
      "default": true,
      "primary": "#cebd09",
      "secondary": "#7da83e",
      "background": "#fcfff0",
      "onPrimary": "#1c1a08"
    },
    "terracotta": {
      "label": "Terracotta",
      "default": false,
      "primary": "#c2622f",
      "secondary": "#3e6fb0",
      "background": "#f5efe4",
      "onPrimary": "#ffffff"
    },
    "forest": {
      "label": "Forest",
      "default": false,
      "primary": "#3e7d5b",
      "secondary": "#c2843a",
      "background": "#f1f1e7",
      "onPrimary": "#ffffff"
    },
    "github": {
      "label": "GitHub",
      "default": false,
      "primary": "#0969da",
      "secondary": "#1f883d",
      "background": "#ffffff",
      "onPrimary": "#ffffff",
      "fonts": {
        "display": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'",
        "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'"
      },
      "paper": {
        "card": "#ffffff",
        "bar": "#f6f8fa",
        "tile": "#eaeef2",
        "field": "#f6f8fa",
        "border": "#d0d7de",
        "borderStrong": "#d0d7de",
        "borderDashed": "#d0d7de",
        "borderSecondary": "#d0d7de"
      },
      "text": {
        "default": "#1f2328",
        "muted": "#59636e",
        "faint": "#818b98"
      },
      "semantic": {
        "allow": "#1a7f37",
        "ask": "#9a6700",
        "off": "#59636e",
        "blocked": "#cf222e",
        "askTint": "#fff8c5",
        "offTint": "#f6f8fa"
      },
      "radii": {
        "tile": "6px",
        "field": "6px",
        "card": "6px",
        "panel": "6px",
        "hero": "12px",
        "pill": "999px"
      }
    }
  },
  "ink": {
    "ink": "#16130f",
    "frame": "#15130f",
    "card": "#211d17",
    "text": "#29251f"
  },
  "paper": {
    "card": "#ffffff",
    "bar": "#fbf7f0",
    "tile": "#ede6d6",
    "field": "#e9e1d1",
    "border": "#ece3d3",
    "borderStrong": "#e8dfd0",
    "borderDashed": "#cfc4b0",
    "borderSecondary": "#d9cdb8",
    "paperSun": "#fcfff0",
    "paperWarm": "#f5efe4"
  },
  "text": {
    "default": "#29251f",
    "muted": "#6f6757",
    "faint": "#9a9180",
    "onInk": "#ede6d6"
  },
  "semantic": {
    "allow": "#2f7d5b",
    "ask": "#b07a1e",
    "off": "#9a9087",
    "blocked": "#b4472e"
  },
  "category": {
    "personal": "#3e7d5b",
    "family": "#4f86c6",
    "work": "#8a6fb0",
    "travel": "#2ba39b",
    "spending": "#c2622f",
    "email": "#b0843a",
    "smarthome": "#6e8b3d"
  },
  "radii": {
    "tile": "8px",
    "field": "11px",
    "card": "14px",
    "panel": "18px",
    "hero": "24px",
    "pill": "999px"
  },
  "elevation": {
    "panel": "0 30px 60px -45px rgba(40, 30, 15, 0.4)",
    "device": "0 40px 80px -30px rgba(0, 0, 0, 0.6)"
  },
  "type": {
    "display": {
      "family": "display",
      "weight": 700,
      "size": "clamp(34px,5vw,56px)",
      "letterSpacing": "-0.025em",
      "lineHeight": 1.03
    },
    "section": {
      "family": "display",
      "weight": 700,
      "size": "clamp(26px,3vw,36px)",
      "letterSpacing": "-0.02em"
    },
    "title": {
      "family": "display",
      "weight": 700,
      "size": "20px",
      "letterSpacing": "-0.01em"
    },
    "body": {
      "family": "body",
      "weight": 400,
      "size": "17px"
    },
    "label": {
      "family": "body",
      "weight": 600,
      "size": "14px"
    },
    "kicker": {
      "family": "body",
      "weight": 700,
      "size": "12px",
      "letterSpacing": "0.08em",
      "transform": "uppercase"
    }
  }
}
